# Alternative Dockerfile using Debian-based golang image (more reliable, git pre-installed)
# Build stage
FROM golang:1.21 AS builder

WORKDIR /app

# Git is already installed in the golang:1.21 image, no need to install it

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/server

# Runtime stage - use alpine for smaller image
FROM alpine:latest

# Install runtime dependencies with retry logic
RUN for i in 1 2 3; do \
        apk update && apk --no-cache add ca-certificates tzdata && break || \
        (echo "Attempt $i failed, retrying..." && sleep 5); \
    done || \
    (echo "Failed to install runtime dependencies after 3 attempts" && exit 1)

WORKDIR /root/

# Copy the binary from builder
COPY --from=builder /app/main .

# Expose port
EXPOSE 8080

# Run the application
CMD ["./main"]
