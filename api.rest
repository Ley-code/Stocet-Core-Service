@baseUrl = http://localhost:8080/api/v1
@token = your_user_token_here
@adminToken = your_admin_token_here

### Health Check
GET {{baseUrl}}/health

### --- AUTH ---

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "user@example.com",
    "password": "password123"
}

### signup
POST {{baseUrl}}/auth/signup
Content-Type: application/json

{
    "email": "newuser@example.com",
    "password": "password123",
    "first_name": "New",
    "last_name": "User"
}

### get me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### delete account
DELETE {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


### --- NEWS ---

### get news
GET {{baseUrl}}/news
Authorization: Bearer {{token}}

### delete news (Admin)
DELETE {{baseUrl}}/news/1
Authorization: Bearer {{adminToken}}


### --- MARKET DATA ---

### get market prices
GET {{baseUrl}}/market-prices
Authorization: Bearer {{token}}

### get tickers
GET {{baseUrl}}/market-prices/tickers
Authorization: Bearer {{token}}

### get ticker price
GET {{baseUrl}}/market-prices/AAPL
Authorization: Bearer {{token}}

### get price history
GET {{baseUrl}}/market-prices/AAPL/history
Authorization: Bearer {{token}}

### get technical indicators
GET {{baseUrl}}/market-prices/AAPL/indicators
Authorization: Bearer {{token}}


### --- CAPITAL SERVICE PROVIDERS ---

### list CSPs
GET {{baseUrl}}/capital-service-providers
Authorization: Bearer {{token}}

### get CSP by id
GET {{baseUrl}}/capital-service-providers/{{cspId}}
Authorization: Bearer {{token}}

### create CSP (Admin)
POST {{baseUrl}}/capital-service-providers
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Example CMSP",
    "license_number": "ECMA-0001",
    "category": "Securities Dealer",
    "status": "Active",
    "services": ["Equity Trading"],
    "paid_up_capital": 10000000
}

### update CSP (Admin)
PUT {{baseUrl}}/capital-service-providers/{{cspId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Updated CMSP"
}

### delete CSP (Admin)
DELETE {{baseUrl}}/capital-service-providers/{{cspId}}
Authorization: Bearer {{adminToken}}


